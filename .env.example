# ─────────────────────────────────────────────────────────────────────────
# pairsmarket — environment
#
# Copy to .env and fill in. .env is gitignored; keep it that way, and keep
# PLATFORM_PRIVKEY on the machine that needs it and nowhere else — not in a
# chat window, not in a screenshot, not in a config file that gets committed.
# ─────────────────────────────────────────────────────────────────────────

PORT=8080

# ─── RPC ──────────────────────────────────────────────────────────────────
# One URL, or several separated by commas. Several is worth it: a badge sweep
# reads 102 accounts and a holder ranking reads every large account, so one
# endpoint gets rate limited well before the work is heavy.
#
# A provider URL usually carries its API key in the query string. That makes
# the whole URL a secret — never return it from an endpoint, never log it.
RPC_URL=
RPC_URLS=

# Some providers key access on the Origin header instead of a token in the
# URL. Set this to the origin they expect if yours does.
RPC_ORIGIN=

# ─── Jupiter ──────────────────────────────────────────────────────────────
# Optional. Prices and route checks work without it, at a lower rate limit;
# without a key expect the odd 429, which the services treat as "unknown"
# rather than as "no route".
JUPITER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# PLATFORM WALLET
#
# Needed only to CREATE a config. Reading pairs, prices, badges, holders and
# trades needs no key at all, and the reference server runs fine without one.
#
# This wallet owns every config on the pad: it is the fee claimer, the
# leftover receiver, and it pays the rent each time a new stock config is
# created. Fund it before the first stock launch — an unfunded wallet fails
# at the create step, after the user has already signed.
# ─────────────────────────────────────────────────────────────────────────
PLATFORM_PUBKEY=
PLATFORM_PRIVKEY=

# ─────────────────────────────────────────────────────────────────────────
# CONFIGS
#
# A DBC config is bound to one quote mint, so there is one config per pair.
# CONFIG_SOL is the only one that must exist up front.
#
# A stock config can be prepared by hand and dropped in here, which wins over
# anything created automatically — use that when you want to choose the curve
# rather than have it derived from the stock's price. The key drops every
# character outside A-Z0-9:
#
#   AAPLx  -> CONFIG_AAPLX
#   BRK.Bx -> CONFIG_BRK_BX
# ─────────────────────────────────────────────────────────────────────────
CONFIG_SOL=

CONFIG_AAPLX=
CONFIG_NVDAX=
CONFIG_TSLAX=
CONFIG_SPYX=

# ─────────────────────────────────────────────────────────────────────────
# CURVE ECONOMICS
#
# migrationQuoteThreshold is denominated in the QUOTE token, not in dollars
# and not in SOL. So it is derived: a dollar target divided by the stock's
# live price. Read docs/CURVE-MATH.md before changing any of these.
# ─────────────────────────────────────────────────────────────────────────
STOCK_MIGRATION_QUOTE_USD=21000
STOCK_TOTAL_SUPPLY=1000000000
STOCK_SUPPLY_ON_MIGRATION=20
STOCK_FEE_BPS=300
# 0 means the platform claims every trading fee, which is what paying holders
# in the quote token requires: it cannot pay out what it cannot claim.
STOCK_CREATOR_FEE_PCT=0

# Where stockConfigs.json lives. Defaults to ./data.
PAIRS_DATA_DIR=
